DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/conversation_investigator
REDIS_URL=redis://127.0.0.1:6379
INVESTIGATOR_QUEUE=conversation-investigator

# Optional: omit to use the default OpenAI endpoint.
# GATEWAY_BASE_URL=http://localhost:8000/v1
GATEWAY_API_KEY=YOUR_API_KEY
GATEWAY_MODEL=gpt-5.6-sol

OPENAI_API_KEY_EMBEDDING=your-openai-embedding-key

# Server timezone for investigation date interpretation (optional).
INVESTIGATOR_TIMEZONE=UTC
