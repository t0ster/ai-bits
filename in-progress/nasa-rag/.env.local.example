# Copy to .env.local and fill in. Commented lines show optional settings with defaults.

ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nasa_rag

OPENAI_API_KEY=
COHERE_API_KEY=
# RERANK_MODEL=rerank-v3.5

# Any OpenAI-compatible endpoint
GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_API_KEY=
GENERATION_MODEL=

# EVALS_TESTSET_MODEL=gpt-6-astra
# EVALS_LLM_JUDGE_MODEL=gpt-6-astra
# CHAT_SPEED_MODELS=["gpt-5.5","gpt-5.6-luna","gpt-5.6-terra","gpt-5.6-sol","gpt-6.1-sol","gpt-6-astra"]

# Default directory for `uv run cli/rag.py ingest-nasa`, relative to the working
# directory; fill it with `uv run cli/download_nasa_books.py`
NASA_ARCHIVE_DIR=data/nasa

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=true
