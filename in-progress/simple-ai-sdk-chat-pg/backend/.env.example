# Copy to backend/.env. `bun run dev`, `db:migrate`, and the CLI load it.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# Shared secret; set the same value in frontend/.env.
BACKEND_API_KEY=change-me-local-backend-key
BACKEND_PORT=4100

# Local Postgres on the default port, or compose.yaml.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/chat

# Optional Langfuse export; general OTel spans always print to stdout.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Verification only: fraction (0-1) of model streams that fail mid-response.
# CHAT_VERIFICATION_STREAM_ERROR_RATE=0
