{
  "name": "@app/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=.env src/server.ts",
    "start": "bun src/server.ts",
    "cli": "bun --env-file=.env src/cli.ts",
    "test": "bun --env-file=.env --env-file=.env.test test --timeout 10000 --max-concurrency 1 test",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --project tsconfig.json",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env drizzle-kit migrate",
    "db:migrate:test": "bun --env-file=.env --env-file=.env.test drizzle-kit migrate"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.75",
    "@app/shared": "workspace:*",
    "@langfuse/otel": "5.13.0",
    "@langfuse/tracing": "5.13.0",
    "@langfuse/vercel-ai-sdk": "5.13.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "ai": "7.0.114",
    "citty": "^0.2.2",
    "drizzle-orm": "^0.45.3",
    "eventsource-parser": "^4.1.1",
    "h3": "^2.0.1-rc.32",
    "neverthrow": "8.2.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2"
  }
}
