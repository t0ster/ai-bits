# Server name reported to MCP clients and the model (default: my-remote-mcp).
MCP_SERVER_NAME=my-remote-mcp
# Short description shown to the model next to the name, e.g. "staging box for project X".
MCP_SERVER_DESCRIPTION=
# Hash of the login password. Generate this line with: bun run hash-password
# Every $ must be escaped as \$ (Bun expands $ in .env values, even inside quotes).
MCP_ACCESS_PASSWORD_HASH=
# At least 32 random characters; generate with: openssl rand -base64 48
TOKEN_SIGNING_SECRET=
# Public URL clients use to reach this server (HTTPS in production).
PUBLIC_URL=http://localhost:8787
# Listen address (default 127.0.0.1). Use the proxy-reachable address when the proxy runs in Docker.
HOST=127.0.0.1
PORT=8787
# Directory the read/bash/edit/write tools resolve relative paths against (default: home directory).
# WORKSPACE_DIR=~/Documents/Workspace
