{
  "name": "my-remote-mcp",
  "version": "0.1.0",
  "description": "Password-protected MCP server that gives ChatGPT, Claude, and other MCP clients shell and file tools on a machine you control.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "module": "src/server.ts",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch run src/server.ts",
    "typecheck": "tsc --noEmit",
    "hash-password": "bun run scripts/hash-password.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
